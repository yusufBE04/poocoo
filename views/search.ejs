<!DOCTYPE html>
<html>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search - Poocoo</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="nav">
  ⚡ Poocoo
  <a href="/" style="float:right;">Home</a>
</div>

<div class="container">

  <h2>🔍 Search Users</h2>

  <!-- SEARCH FORM -->
  <div class="post">

    <form method="GET" action="/search">
      <input 
        name="q" 
        placeholder="Search username..." 
        value="<%= query %>"
        required
      >
      <button type="submit">Search 🔍</button>
    </form>

  </div>

  <!-- RESULTS -->
  <h3>Results</h3>

  <% if (!results || results.length === 0) { %>

    <div class="post">
      <p>No users found.</p>
    </div>

  <% } %>

  <% if (results && results.length > 0) { %>

    <% results.forEach(user => { %>

      <div class="post">

        <h3>@<%= user.username %></h3>

        <p>🔗 Circles: <%= user.circles ? user.circles.length : 0 %></p>

        <a href="/profile/<%= user.username %>">
          View Profile →
        </a>

      </div>

    <% }) %>

  <% } %>

</div>

</body>
</html>
