<!DOCTYPE html>
<html>
<head>
  <title>Poocoo Messages</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="nav">
  ⚡ Poocoo
  <a href="/" style="float:right;">Home</a>
</div>

<div class="container">

  <h2>💬 Messages</h2>

  <!-- SEND MESSAGE BOX -->
  <div class="post">

    <h3>Send a Message</h3>

    <form method="POST" action="/message">

      <input 
        name="to" 
        placeholder="Send to username" 
        required
      >

      <textarea 
        name="text" 
        placeholder="Write your message..." 
        required
      ></textarea>

      <button type="submit">Send 💬</button>

    </form>

  </div>

  <!-- MESSAGE LIST -->
  <h3>Inbox / Sent</h3>

  <% if (!messages || messages.length === 0) { %>

    <div class="post">
      <p>No messages yet.</p>
    </div>

  <% } %>

  <% if (messages && messages.length > 0) { %>

    <% messages.reverse().forEach(msg => { %>

      <div class="post">

        <p>
          <b>From:</b> @<%= msg.from %> <br>
          <b>To:</b> @<%= msg.to %>
        </p>

        <p><%= msg.text %></p>

        <small>⏱ <%= msg.time %></small>

      </div>

    <% }) %>

  <% } %>

</div>

</body>
</html>
