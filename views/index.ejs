<!DOCTYPE html>
<html>
<head>
  <title>Poocoo</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- NAVBAR -->
<div class="nav">
  ⚡ Poocoo

  <a href="/" style="margin-left:15px;">Home</a>
  <a href="/search" style="margin-left:15px;">🔍 Search</a>
  <a href="/messages" style="margin-left:15px;">💬 Messages</a>
  <a href="/notifications" style="margin-left:15px;">🔔 Notifications</a>
</div>

<div style="margin-top:10px;">

  <form method="POST" action="/react" style="display:inline;">
    <input type="hidden" name="id" value="<%= post.id %>">
    <input type="hidden" name="type" value="echo">
    <button>⚡ <%= post.reactions.echo.length %></button>
  </form>

  <form method="POST" action="/react" style="display:inline;">
    <input type="hidden" name="id" value="<%= post.id %>">
    <input type="hidden" name="type" value="love">
    <button>❤️ <%= post.reactions.love.length %></button>
  </form>

  <form method="POST" action="/react" style="display:inline;">
    <input type="hidden" name="id" value="<%= post.id %>">
    <input type="hidden" name="type" value="fire">
    <button>🔥 <%= post.reactions.fire.length %></button>
  </form>

  <form method="POST" action="/react" style="display:inline;">
    <input type="hidden" name="id" value="<%= post.id %>">
    <input type="hidden" name="type" value="laugh">
    <button>😂 <%= post.reactions.laugh.length %></button>
  </form>

  <form method="POST" action="/react" style="display:inline;">
    <input type="hidden" name="id" value="<%= post.id %>">
    <input type="hidden" name="type" value="wow">
    <button>😮 <%= post.reactions.wow.length %></button>
  </form>

</div>       
        
<!-- LIVE FEED SCRIPT -->
<script>
async function loadPosts() {
  try {
    const res = await fetch("/api/posts");
    const posts = await res.json();

    const container = document.getElementById("feed");

    container.innerHTML = "";

    <div id="feed">

  <% posts.forEach(post => { %>

    <div class="post">

      <h3>👤 <%= post.username %></h3>

      <small>
        ⏱ <%= post.time %> • Mood: <%= post.mood %>
      </small>

      <p><%= post.content %></p>

      <form method="POST" action="/like">
        <input type="hidden" name="id" value="<%= post.id %>">
        <button>⚡ Echo (<%= post.likes.length %>)</button>
      </form>

    </div>

  <% }) %>

</div>
     `;
    });

  } catch (err) {
    console.log("Error loading posts:", err);
  }
}

loadPosts();
setInterval(loadPosts, 5000);
</script>

</body>
</html>
