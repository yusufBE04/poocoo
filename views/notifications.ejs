<!DOCTYPE html>
<html>
<head>
  <title>Notifications</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="nav">
  ⚡ Poocoo
  <a href="/" style="float:right;">Home</a>
</div>

<div class="container">

  <h2>🔔 Notifications</h2>

  <% if (notifs.length === 0) { %>
    <p>No notifications yet.</p>
  <% } %>

  <% notifs.forEach(n => { %>

    <div class="post">
      <p>
        <b>@<%= n.from %></b> <%= n.message %>
      </p>
      <small><%= n.time %></small>
    </div>

  <% }) %>

</div>

</body>
</html>
